  {
   "id": "sched",
   "name": "Scheduler tweaks",
   "desc": "No power throttling of background apps, one service per process, no dynamic timer tick.",
   "cat": "Power",
   "ops": [
    {
     "r": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling",
     "n": "PowerThrottlingOff",
     "v": 1
    },
